  "service": {
    "start": [
      "{{bin}}/mongod",
      "--config",
      "{{conf}}/mongod.conf",
      "--unixSocketPrefix",
      "{{sock}}"
    ],
    "start_windows": [
      "{{bin}}/mongod.exe",
      "--config",
      "{{conf}}/mongod.conf"
    ],
    "default_port": 27017
  },
  "config_templates": {
    "mongod.conf": "storage:\n  dbPath: \"{{data}}\"\nnet:\n  port: {{port}}\n  bindIp: 127.0.0.1\nprocessManagement:\n  pidFilePath: \"{{run}}/mongod.pid\"\nsystemLog:\n  destination: file\n  path: \"{{logs}}/mongodb-{{version}}.log\"\n  logAppend: true\n"
  }
