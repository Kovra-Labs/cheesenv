  "module_files": {
    "composer": "#!/bin/sh\n# Runs Composer with the PHP CLI bundled in this module; works through the PATH shim (a symlink).\nself=$(readlink \"$0\" 2>/dev/null) || self=$0\ndir=$(dirname \"$self\")\nexec \"$dir/php/php\" \"$dir/composer.phar\" \"$@\"\n",
    "composer.cmd": "@\"%~dp0php\\php.exe\" \"%~dp0composer.phar\" %*\r\n"
  },
  "setup": {
    "commands": [
      [
        "{{prefix}}/php/php",
        "-r",
        "chmod(\"composer\", 0755);"
      ],
      [
        "{{prefix}}/composer",
        "--version",
        "--no-interaction"
      ]
    ],
    "commands_windows": [
      [
        "{{prefix}}/php/php.exe",
        "{{prefix}}/composer.phar",
        "--version",
        "--no-interaction"
      ]
    ]
  },
  "shims": {
    "composer": "composer"
  },
  "shims_windows": {
    "composer": "composer.cmd"
  }
}
