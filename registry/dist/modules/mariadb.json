{
  "name": "mariadb",
  "category": "database",
  "license": "GPL-2.0",
  "homepage": "https://mariadb.org",
  "description": {
    "en": "MariaDB Community Server (LTS)",
    "id": "MariaDB Community Server (LTS)"
  },
  "companions": [
    "phpmyadmin"
  ],
  "versions": [
    {
      "version": "12.3.4",
      "assets": {
        "linux-x64": {
          "url": "https://downloads.mariadb.org/rest-api/mariadb/12.3.4/mariadb-12.3.4-linux-systemd-x86_64.tar.gz",
          "sha256": "26868ab54e3fffa822ffe433537e9c6dde0bdaa45f45a83ef43bd72e29b58baa",
          "format": "tar.gz",
          "strip": 1,
          "bin_dir": "bin"
        },
        "windows-x64": {
          "url": "https://downloads.mariadb.org/rest-api/mariadb/12.3.4/mariadb-12.3.4-winx64.zip",
          "sha256": "178020ae8ff7d0caf77b5a3ad7e33e574e13001352d31b02503f97224e4b1f77",
          "format": "zip",
          "strip": 1,
          "bin_dir": "bin"
        }
      }
    },
    {
      "version": "11.8.10",
      "assets": {
        "linux-x64": {
          "url": "https://downloads.mariadb.org/rest-api/mariadb/11.8.10/mariadb-11.8.10-linux-systemd-x86_64.tar.gz",
          "sha256": "15ca40274597af84fa8f89f8248b37740c5a712c003df80b4c7b32a4486e2027",
          "format": "tar.gz",
          "strip": 1,
          "bin_dir": "bin"
        },
        "windows-x64": {
          "url": "https://downloads.mariadb.org/rest-api/mariadb/11.8.10/mariadb-11.8.10-winx64.zip",
          "sha256": "05d04b46763ea3dc9111bfc82dc061e0a158c682a73d31ba34b13f2653c88d17",
          "format": "zip",
          "strip": 1,
          "bin_dir": "bin"
        }
      }
    }
  ],
  "service": {
    "start": [
      "{{bin}}/mariadbd",
      "--defaults-file={{conf}}/my.cnf"
    ],
    "start_windows": [
      "{{bin}}/mariadbd.exe",
      "--defaults-file={{conf}}/my.cnf"
    ],
    "default_port": 3307,
    "credentials": {
      "user": "root"
    },
    "init": {
      "files": {
        "init.sql": "ALTER USER 'root'@'localhost' IDENTIFIED BY '{{password}}';\nSHUTDOWN;\n"
      },
      "commands": [
        [
          "{{prefix}}/scripts/mariadb-install-db",
          "--defaults-file={{conf}}/my.cnf",
          "--auth-root-authentication-method=normal",
          "--skip-test-db"
        ],
        [
          "{{bin}}/mariadbd",
          "--defaults-file={{conf}}/my.cnf",
          "--skip-networking",
          "--init-file={{init}}/init.sql"
        ]
      ],
      "commands_windows": [
        [
          "{{bin}}/mariadb-install-db.exe",
          "--datadir={{data}}"
        ],
        [
          "{{bin}}/mariadbd.exe",
          "--defaults-file={{conf}}/my.cnf",
          "--skip-networking",
          "--init-file={{init}}/init.sql"
        ]
      ]
    }
  },
  "config_templates": {
    "my.cnf": "[mysqld]\nbasedir={{prefix}}\ndatadir={{data}}\nport={{port}}\nbind-address=127.0.0.1\nsocket={{sock}}/mariadbd.sock\npid-file={{run}}/mariadbd.pid\nlog-error={{logs}}/mariadb-{{version}}-error.log\ncharacter-set-server=utf8mb4\nmax_allowed_packet=64M\n\n[client]\nport={{port}}\nsocket={{sock}}/mariadbd.sock\n"
  }
}
