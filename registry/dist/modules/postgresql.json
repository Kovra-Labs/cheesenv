  "service": {
    "start": [
      "{{bin}}/postgres",
      "-D",
      "{{data}}",
      "-p",
      "{{port}}",
      "-c",
      "listen_addresses=127.0.0.1",
      "-c",
      "unix_socket_directories={{sock}}"
    ],
    "start_windows": [
      "{{bin}}/postgres",
      "-D",
      "{{data}}",
      "-p",
      "{{port}}",
      "-c",
      "listen_addresses=127.0.0.1"
    ],
    "default_port": 5432,
    "credentials": {
      "user": "postgres"
    },
    "init": {
      "files": {
        "pwfile": "{{password}}\n"
      },
      "commands": [
        [
          "{{bin}}/initdb",
          "-D",
          "{{data}}",
          "-U",
          "postgres",
          "--pwfile={{init}}/pwfile",
          "-E",
          "UTF8",
          "--no-locale",
          "--auth=scram-sha-256",
          "--no-instructions"
        ]
      ]
    }
  },
  "config_templates": {}
}
