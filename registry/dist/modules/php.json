  "service": {
    "start": [
      "{{bin}}/php-fpm",
      "-F",
      "-y",
      "{{conf}}/php-fpm.conf",
      "-c",
      "{{conf}}/php.ini"
    ],
    "default_port": 9000
  },
  "config_templates": {
    "php-fpm.conf": "[global]\npid = {{run}}/php-fpm.pid\nerror_log = {{logs}}/php-{{version}}-fpm.log\ndaemonize = no\n\n[www]\nlisten = 127.0.0.1:{{port}}\npm = dynamic\npm.max_children = 5\npm.start_servers = 2\npm.min_spare_servers = 1\npm.max_spare_servers = 3\ncatch_workers_output = yes\n",
    "php.ini": "memory_limit = 256M\nupload_max_filesize = 64M\npost_max_size = 64M\nmax_execution_time = 120\ndisplay_errors = On\nerror_reporting = E_ALL\nlog_errors = On\nerror_log = {{logs}}/php-{{version}}-error.log\ndate.timezone = UTC\n"
  }
