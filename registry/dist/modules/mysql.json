{
  "name": "mysql",
  "category": "database",
  "license": "GPL-2.0",
  "homepage": "https://www.mysql.com",
  "description": {
    "en": "MySQL Community Server (LTS)",
    "id": "MySQL Community Server (LTS)"
  },
  "companions": [
    "phpmyadmin"
  ],
  "versions": [
    {
      "version": "8.4.11",
      "assets": {
        "linux-x64": {
          "url": "https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.11-linux-glibc2.28-x86_64-minimal.tar.xz",
          "sha256": "383f54e124d5f325d67f0c6912a8f96814eedc761a17ea30112e52fa4cc6b143",
          "format": "tar.xz",
          "strip": 1,
          "bin_dir": "bin"
        },
        "macos-arm64": {
          "url": "https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.11-macos15-arm64.tar.gz",
          "sha256": "b96e00493bc3499b9ffd7f08d65c5d64933af0383a8287d9873b64f94c2d6009",
          "format": "tar.gz",
          "strip": 1,
          "bin_dir": "bin"
        },
        "macos-x64": {
          "url": "https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.11-macos15-x86_64.tar.gz",
          "sha256": "90e8aea10698d01b978f0179e72e8d5e2cbe9f9bd5771e88b0b75d7c82244d3f",
          "format": "tar.gz",
          "strip": 1,
          "bin_dir": "bin"
        },
        "windows-x64": {
          "url": "https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-8.4.11-winx64.zip",
          "sha256": "a492371d687d2bab088b0062581144a0044b8964baefdf4faa579292b423d25c",
          "format": "zip",
          "strip": 1,
          "bin_dir": "bin"
        }
      }
    }
  ],
  "service": {
    "start": [
      "{{bin}}/mysqld",
      "--defaults-file={{conf}}/my.cnf"
    ],
    "default_port": 3306,
    "credentials": {
      "user": "root"
    },
    "init": {
      "files": {
        "init.sql": "ALTER USER 'root'@'localhost' IDENTIFIED BY '{{password}}';\n"
      },
      "commands": [
        [
          "{{bin}}/mysqld",
          "--defaults-file={{conf}}/my.cnf",
          "--initialize-insecure",
          "--init-file={{init}}/init.sql"
        ]
      ]
    }
  },
  "config_templates": {
    "my.cnf": "[mysqld]\nbasedir={{prefix}}\ndatadir={{data}}\nport={{port}}\nbind-address=127.0.0.1\nsocket={{sock}}/mysqld.sock\npid-file={{run}}/mysqld.pid\nlog-error={{logs}}/mysql-{{version}}-error.log\nmysqlx=OFF\ncharacter-set-server=utf8mb4\ncollation-server=utf8mb4_0900_ai_ci\nmax_allowed_packet=64M\n\n[client]\nport={{port}}\nsocket={{sock}}/mysqld.sock\n"
  }
}
