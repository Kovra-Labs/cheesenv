{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only Stackyard's registered commands plus event listening.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-registry-index",
    "allow-registry-module",
    "allow-install-module",
    "allow-update-panel",
    "allow-uninstall-module",
    "allow-set-runtime",
    "allow-list-services",
    "allow-start-service",
    "allow-stop-service",
    "allow-restart-service",
    "allow-start-all",
    "allow-stop-all",
    "allow-set-service-options",
    "allow-check-port",
    "allow-list-logs",
    "allow-read-log",
    "allow-clear-log",
    "allow-open-service-url",
    "allow-open-panel",
    "allow-open-folder",
    "allow-get-credentials",
    "allow-check-update",
    "allow-install-update"
  ]
}
